{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "ClickHouse Drilldown",
  "id": "aveniq-clickhousedrilldown-app",
  "autoEnabled": true,
  "info": {
    "description": "Queryless browsing of OpenTelemetry metrics, logs and traces stored in ClickHouse",
    "author": { "name": "Aveniq" },
    "keywords": ["clickhouse", "opentelemetry", "drilldown", "metrics", "logs", "traces"],
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "links": [],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Metrics",
      "path": "/a/aveniq-clickhousedrilldown-app/metrics",
      "addToNav": true,
      "defaultNav": true
    },
    { "type": "page", "name": "Logs", "path": "/a/aveniq-clickhousedrilldown-app/logs", "addToNav": true },
    { "type": "page", "name": "Traces", "path": "/a/aveniq-clickhousedrilldown-app/traces", "addToNav": true }
  ],
  "extensions": {
    "addedLinks": [
      {
        "targets": ["grafana/dashboard/panel/menu", "grafana/explore/toolbar/action"],
        "title": "Open in ClickHouse Drilldown",
        "description": "Browse the data of this query in ClickHouse Drilldown"
      }
    ]
  },
  "dependencies": {
    "grafanaDependency": ">=11.6.11",
    "plugins": [{ "id": "grafana-clickhouse-datasource", "type": "datasource", "name": "ClickHouse" }]
  }
}
